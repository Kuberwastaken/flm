  "policy": {
    "name": "Scripted bilateral odor-A approach with latched source-contact stop",
    "used_channels": [
      "odor_a_left",
      "odor_a_right",
      "source_contact"
    ],
    "unused_channels": [
      "odor_b_left",
      "odor_b_right",
      "sugar_contact"
    ],
    "control_step_s": 0.01,
    "base_drive": 0.8,
    "steering_gain": 24.0,
    "maximum_turn": 0.4,
    "contrast_epsilon": 1e-12,
    "formula": "contrast=(A_left-A_right)/(A_left+A_right+epsilon); turn=clip(gain*contrast,-maximum_turn,maximum_turn); drive=[base-turn,base+turn]",
    "stop": "Latch any-source contact >= 0.5; thereafter both descending drives are zero",
    "missing_odor": "Equal zero odor yields equal drives until any-source contact",
    "coordinates_or_reward_identity_input": false,
    "training_updates": 0
  },
